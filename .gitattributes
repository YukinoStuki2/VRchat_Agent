# Preserve reviewed Candidate Windows source bytes on every CI checkout.
/.gitattributes text eol=lf
# PBS notice bodies are upstream bytes; never normalize their pinned hashes.
/Candidate~/distribution/python-licenses/** -text
# Candidate source snapshots include text fixtures/docs; binary detection stays automatic.
/Candidate~/** text=auto eol=lf
/Candidate~/launcher/windows_processes.py text eol=lf
/Candidate~/tests/test_launcher_candidate_windows.py text eol=lf
/Candidate~/diagnostics/windows_handles.py text eol=lf
/Candidate~/diagnostics/snapshot.py text eol=lf
/Candidate~/diagnostics/verify_windows.py text eol=lf
/Candidate~/tests/test_diagnostics_windows_kernel.py text eol=lf
/Candidate~/distribution/requirements.in text eol=lf
/Candidate~/distribution/requirements.lock text eol=lf
/Candidate~/distribution/verify_dependency_install.py text eol=lf
/Candidate~/runtime/candidate_auth.py text eol=lf
/Candidate~/runtime/run_identity.py text eol=lf
/Candidate~/tests/test_run_identity.py text eol=lf
/.github/workflows/candidate-dependencies.yml text eol=lf
/Candidate~/experiments/windows_tls_pipe.py text eol=lf
/Candidate~/runtime/tls*.py text eol=lf
/Candidate~/tests/test_tls*.py text eol=lf
/Candidate~/runtime/** text eol=lf
/Candidate~/launcher/** text eol=lf
/Candidate~/native/** text eol=lf
/Candidate~/dependencies/mcp-1.29.1/** text eol=lf
